<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!--
    AATool is a .NET Framework 4.8 application. It is built with the .NET SDK
    ("dotnet build") on any OS and uses MonoGame DesktopGL (SDL2 + OpenGL), so the
    same build runs on Windows (.NET Framework) and Linux (Mono).
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>AATool</RootNamespace>
    <AssemblyName>AATool</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <StartupObject>AATool.Program</StartupObject>
    <ApplicationIcon>assets\icons\aatool.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Platforms>AnyCPU;x86</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- resx files containing icons/bitmaps can only be compiled off Windows when pre-serialized -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>..\compiled\debug\</OutputPath>
    <DefineConstants>TRACE;DEBUG</DefineConstants>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>..\compiled\release\</OutputPath>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.0.1641" />
    <PackageReference Include="Cyotek.Drawing.BitmapFont" Version="2.0.1" />
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="SpriteFontPlus" Version="0.9.2" />
    <PackageReference Include="SSH.NET" Version="2020.0.2" />
    <PackageReference Include="StbImageSharp" Version="2.22.6" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.24.8" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Winforms\**\*.Designer.cs">
      <DependentUpon>$([System.String]::Copy('%(Filename)').Replace('.Designer', '')).cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!-- launcher for linux, where .exe files are run with mono -->
    <None Update="aatool.sh" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- runtime assets loaded from disk next to the executable -->
    <None Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- assets that exist in the repository but are not shipped -->
    <None Update="assets\experimental\**\*" CopyToOutputDirectory="Never" />
    <None Update="assets\objectives\minecraft.json" CopyToOutputDirectory="Never" />
    <None Update="assets\sprites\ab_guide\ab_example_popup.png" CopyToOutputDirectory="Never" />
    <None Update="assets\sprites\blocks\misc\end_portal_frame%242x2x30.png" CopyToOutputDirectory="Never" />
    <None Update="assets\sprites\blocks\sculk\skulk_sensor_block^32%2448x32x2.png" CopyToOutputDirectory="Never" />
    <None Update="assets\sprites\blocks\sculk\skulk_sensor_block^48%2448x32x2.png" CopyToOutputDirectory="Never" />
    <None Update="assets\sprites\blocks\sculk\skulk_vein^48%2432.png" CopyToOutputDirectory="Never" />
    <None Update="assets\sprites\deaths\high_fall^48%24135x34.png" CopyToOutputDirectory="Never" />
    <None Update="assets\sprites\global\badges\player_frames\player_frame_netherite_glint%24825.png" CopyToOutputDirectory="Never" />
    <None Update="assets\sprites\global\badges\ranks_gold\badge_rank_large.png" CopyToOutputDirectory="Never" />
    <None Update="assets\sprites\global\badges\ranks_gold\badge_rank_medium.png" CopyToOutputDirectory="Never" />
    <None Update="assets\sprites\global\badges\ranks_gold\badge_rank_small.png" CopyToOutputDirectory="Never" />
    <None Update="assets\sprites\global\badges\roghierug.png" CopyToOutputDirectory="Never" />
    <None Update="assets\sprites\global\gui\frames\flags\frame_flag_shading^52.png" CopyToOutputDirectory="Never" />
    <None Update="assets\sprites\global\gui\icons\food.png" CopyToOutputDirectory="Never" />
    <None Update="assets\sprites\global\gui\icons\syncing%2463.png" CopyToOutputDirectory="Never" />
    <None Update="assets\sprites\global\items\diamond_axe.png" CopyToOutputDirectory="Never" />
    <None Update="assets\templates\*.bak" CopyToOutputDirectory="Never" />
  </ItemGroup>
</Project>
